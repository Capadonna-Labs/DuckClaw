{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DuckClaw Full",
  "version": "0.1.0",
  "identifier": "com.duckclaw.full",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "DuckClaw Full",
        "width": 720,
        "height": 560,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline'; connect-src 'self' http://127.0.0.1:* http://localhost:* ipc: http://ipc.localhost https://tauri.localhost https://www.docker.com https://desktop.docker.com",
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": ["resources/"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.ico"
    ]
  }
}
