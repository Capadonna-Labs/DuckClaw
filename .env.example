# Copia a `.env` y rellena valores. No commitees `.env`.
# Runbook: docs/COMANDOS.md
# Arquitectura: docs/specs/features/platform/DB_FIRST_CORE_REFACTOR.md
#
# Reglas:
# - Stack core = Gateway + DB-Writer + Knowledge-Indexer + Heartbeat + Admin.
# - Bóveda: una clave canónica DUCKCLAW_GATEWAY_DB_PATH (gateway_db resuelve rutas).
# - Tenant, Telegram, webhooks → admin_runtime_settings / Integraciones (no .env).
# - Tras cambiar vars de stack: uv run duckops stack deploy

DOTENV_IMMUTABLE=1

# ── Bóveda gateway (hub ACL, policies, chat, writes) ─────────────────────────
DUCKCLAW_GATEWAY_DB_PATH=db/private/default/duckclaw.duckdb
# DUCKCLAW_SHARED_DB_PATH=db/shared/default/shared.duckdb
# DUCKCLAW_MULTI_VAULT_INITIAL_VAULT_ID=

# ── Gateway + Redis ───────────────────────────────────────────────────────────
DUCKCLAW_GATEWAY_HOST=127.0.0.1
DUCKCLAW_GATEWAY_PORT=8000
DUCKCLAW_GATEWAY_URL=http://127.0.0.1:8000
DUCKCLAW_MCP_PORT=8001
REDIS_URL=redis://localhost:6379/0
# DUCKCLAW_REPO_ROOT=/absolute/path/to/duckclaw
# DUCKCLAW_PM2_PYTHON=/absolute/path/to/duckclaw/.venv/bin/python3
DUCKCLAW_CHAT_PARALLEL_INVOCATIONS=true
HEARTBEAT_PLAN_TITLE_INLINE_MAX=90

# ── LLM providers ────────────────────────────────────────────────────────────
# Preferencia runtime: DUCKCLAW_LLM_* (gateway). LLM_* se copia al arrancar si falta DUCKCLAW_*.
DUCKCLAW_LLM_PROVIDER=deepseek
DUCKCLAW_LLM_MODEL=deepseek-chat
DUCKCLAW_LLM_BASE_URL=https://api.deepseek.com/
DEEPSEEK_API_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
# DUCKCLAW_LLM_INVOKE_MAX_ATTEMPTS=3
# DUCKCLAW_GROQ_MAX_INPUT_TOKENS=5000

# ── MLX (inferencia local Mac, opcional) ─────────────────────────────────────
# MLX_MODEL_PATH=/path/to/your/mlx/model
# MLX_PYTHON=/path/to/mlx_env/bin/python
# MLX_PORT=8080
# DUCKCLAW_LLM_PROVIDER=mlx
# DUCKCLAW_LLM_BASE_URL=http://127.0.0.1:8080/v1
# SLM eval (teacher-student): Mac mini MLX-Inference vía Tailscale
# DUCKCLAW_SLM_BASE_URL=http://100.x.x.x:8080/v1

# ── Admin consola (apps/duckclaw-admin) ──────────────────────────────────────
DUCKCLAW_ADMIN_API_KEY=change-me-local-admin-key
DUCKCLAW_ADMIN_EMAIL=admin@duckclaw.local
DUCKCLAW_ADMIN_PASSWORD=change-me-min-8-chars
DUCKCLAW_ADMIN_PORT=3001
GATEWAY_INTERNAL_URL=http://127.0.0.1:8000
ENV=development
SESSION_TTL_SECONDS=43200
COOKIE_DOMAIN=
ARGON2_TIME=2
ARGON2_MEMORY_KB=65536
ARGON2_PARALLELISM=4
PBKDF2_ITERATIONS=260000
SHOW_DEV_HINT=false
# DUCKCLAW_DEV_MODE=1

# ── Integraciones opcionales (configurar en Admin → Integraciones cuando aplique) ─
TAVILY_API_KEY=
GITHUB_TOKEN=
# HIGGSFIELD_API_KEY=          # REST bridge (api.higgsfield.ai) — no usar para MCP alojado
# DUCKCLAW_ADMIN_URL=http://127.0.0.1:3001   # OAuth MCP callback redirect target
# DUCKCLAW_MCP_OAUTH_REDIRECT_URI=           # override callback URL if needed
# COMFYUI_API_URL=http://127.0.0.1:8188

# ── Observability (opcional) ───────────────────────────────────────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=duckclaw
SEND_TO_LANGSMITH=false
# DUCKCLAW_SAVE_CONVERSATION_TRACES=true
# DUCKCLAW_CONVERSATION_TRACES_FORMAT=sft
# DUCKCLAW_CONVERSATION_TRACES_DIR=

# ── Sensory STT/TTS (opcional) ────────────────────────────────────────────────
# DUCKCLAW_SENSORY_BASE_URL=http://100.x.x.x:8001

# ── Voice Pipecat (opcional; PM2 DuckClaw-Voice) ──────────────────────────────
# DUCKCLAW_VOICE_ENABLED=false
# DUCKCLAW_VOICE_INTERNAL_URL=http://127.0.0.1:8012

# ── Context monitor (compactación LLM, default ON) ────────────────────────────
# DUCKCLAW_CONTEXT_PRUNE_ENABLED=1
# DUCKCLAW_CONTEXT_PRUNE_MAX_TOKENS_M=4

# ── RAG / Knowledge ───────────────────────────────────────────────────────────
DUCKCLAW_KNOWLEDGE_ALLOWED_ROOTS=
DUCKCLAW_KNOWLEDGE_OUTPUT_ROOTS=
# DUCKCLAW_KNOWLEDGE_AUTO_SYNC=true
# DUCKCLAW_KNOWLEDGE_AUTO_SYNC_POLL_SEC=15
# DUCKCLAW_MLX_EMBEDDINGS_URL=http://127.0.0.1:8080/v1/embeddings
# DUCKCLAW_KNOWLEDGE_EMBED_BATCH_SIZE=32
# DUCKCLAW_KNOWLEDGE_INDEXER_MAX_INFLIGHT=1

# ── Performance stack ───────────────────────────────────────────────────────
DUCKCLAW_WRITE_POLL_SEC=0
# DUCKCLAW_WORKER_GRAPH_CACHE_ENABLED=true
# DUCKCLAW_WORKER_GRAPH_CACHE_MAX_ENTRIES=8
# DUCKCLAW_WORKER_GRAPH_CACHE_TTL_SEC=600
