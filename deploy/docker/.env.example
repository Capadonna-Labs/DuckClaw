# DuckClaw Full Docker — copy to .env (launcher does this automatically).
# No Quant-Trader / quant_core. Platform stack only.

DOTENV_IMMUTABLE=1

# ── Bóveda gateway (vacía al primer arranque; sin schemas de workers) ─────────
DUCKCLAW_GATEWAY_DB_PATH=/data/duckclaw.duckdb

# ── Gateway + Redis (nombres de servicio Compose) ────────────────────────────
DUCKCLAW_GATEWAY_HOST=0.0.0.0
DUCKCLAW_GATEWAY_PORT=8000
DUCKCLAW_GATEWAY_URL=http://127.0.0.1:8000
GATEWAY_INTERNAL_URL=http://gateway:8000
REDIS_URL=redis://redis:6379/0
DUCKCLAW_REPO_ROOT=/app
DUCKCLAW_CHAT_PARALLEL_INVOCATIONS=true

# Full stack — never Lite / Spawn-inline
LITE_MODE=0
DUCKCLAW_SPAWN_PROFILE=0

# Sandbox image (built by compose service `sandbox`)
STRIX_SANDBOX_IMAGE=duckclaw/sandbox:latest

# ── LLM (optional at first boot; configure later in Admin → Integraciones) ───
DUCKCLAW_LLM_PROVIDER=none_llm
DUCKCLAW_LLM_MODEL=
DUCKCLAW_LLM_BASE_URL=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=

# ── Admin (launcher generates random secrets on first copy) ──────────────────
DUCKCLAW_ADMIN_API_KEY=change-me-local-admin-key
DUCKCLAW_ADMIN_EMAIL=admin@duckclaw.local
DUCKCLAW_ADMIN_PASSWORD=change-me-min-8-chars
DUCKCLAW_ADMIN_PORT=3001
DUCKCLAW_ADMIN_URL=http://127.0.0.1:3001
ENV=production
SESSION_TTL_SECONDS=43200
COOKIE_DOMAIN=
ARGON2_TIME=2
ARGON2_MEMORY_KB=65536
ARGON2_PARALLELISM=4
PBKDF2_ITERATIONS=260000
SHOW_DEV_HINT=false

# ── Optional Tailscale (compose --profile tailscale) ─────────────────────────
# TS_AUTHKEY=
# TS_HOSTNAME=duckclaw-full

# ── Observability ────────────────────────────────────────────────────────────
LANGCHAIN_TRACING_V2=false
PYTHONUNBUFFERED=1
