{
  "name": "duckclaw-repo-root",
  "private": true,
  "description": "Monorepo DuckClaw. Admin UI: pnpm en apps/duckclaw-admin (admin:*). Locks: uv.lock (Python), apps/duckclaw-admin/pnpm-lock.yaml (admin).",
  "scripts": {
    "kanban": "npx -y vibe-kanban --port 3333",
    "dev:admin": "pnpm --dir apps/duckclaw-admin dev",
    "admin:dev": "pnpm --dir apps/duckclaw-admin dev",
    "admin:dev:tailscale": "pnpm --dir apps/duckclaw-admin dev:tailscale",
    "admin:serve-tailscale": "uv run duckops ingress serve-admin",
    "admin:build": "pnpm --dir apps/duckclaw-admin build",
    "admin:start": "pnpm --dir apps/duckclaw-admin start",
    "admin:lint": "pnpm --dir apps/duckclaw-admin lint",
    "admin:install": "pnpm --dir apps/duckclaw-admin install",
    "stack:up": "uv run duckops stack up",
    "stack:status": "uv run duckops stack status",
    "dev:local": "pnpm stack:up && pnpm admin:dev",
    "crm:bootstrap-db": "uv run duckops db bootstrap"
  }
}
