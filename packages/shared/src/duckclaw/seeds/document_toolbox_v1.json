{
  "pack_version": "document_toolbox_v1",
  "metadata": {
    "seed": "document_toolbox_v1",
    "scope": "framework",
    "locale": "es",
    "spec": "docs/specs/features/platform/DOCUMENT_TOOLBOX.md"
  },
  "lanes": {
    "ingest_native": [".md", ".markdown", ".txt", ".json", ".csv"],
    "extract_markitdown": [".pdf", ".docx", ".doc", ".pptx", ".ppt", ".xlsx", ".xls", ".html", ".htm"],
    "author": ["write_output_document", "render_docx_template"],
    "convert_pandoc": {
      "inputs": [".md", ".markdown", ".txt", ".html", ".htm"],
      "outputs": ["docx", "pdf", "html"]
    }
  },
  "baseline_tools": [
    "extract_document_text",
    "write_output_document",
    "render_docx_template",
    "convert_document"
  ],
  "templates": [
    {
      "template_id": "corporate_report",
      "display_name": "Informe corporativo",
      "description": "Portada con título, subtítulo, autor y cuerpo en secciones.",
      "variables": ["title", "subtitle", "author", "tenant_name", "body", "date"]
    }
  ]
}
