{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "default",
  "description": "Default DuckClaw desktop capabilities",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-spawn",
    "shell:allow-kill",
    "updater:default",
    "process:allow-restart",
    "allow-prepare-update"
  ],
  "remote": {
    "urls": ["http://127.0.0.1:3000/*", "http://localhost:3000/*"]
  }
}
