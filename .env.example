# Copia a `.env` y rellena valores. No commitees `.env`.
# Runbook: docs/COMANDOS.md · Arquitectura: docs/specs/features/platform/DB_FIRST_CORE_REFACTOR.md

# ── MLX (inferencia local Mac, opcional) ─────────────────────────────────────
MLX_MODEL_PATH=/path/to/your/mlx/model
MLX_PYTHON=/path/to/mlx_env/bin/python
MLX_PORT=8080
MLX_MODEL_ID=/path/to/your/mlx/model
# LoRA: MLX_ADAPTER_PATH=packages/agents/train/gemma4/adapters_lora_yaml
# Visión (otro puerto): MLX_VISION_PORT=8081, DUCKCLAW_VLM_MLX_BASE_URL=http://127.0.0.1:8081/v1
# Mac Mini disk preflight (opt-in; sin estas vars = comportamiento legacy)
# DUCKCLAW_VLM_MLX_DISK_HEALTH_URL=http://100.99.72.63:9082/health/disk
# DUCKCLAW_VLM_MLX_DISK_MIN_FREE_PCT=10
# DUCKCLAW_VLM_MLX_ENOSPC_HINT=1
# Stack local MLX: pm2 start config/ecosystem.mlx.config.cjs
# DUCKCLAW_LLM_PROVIDER=mlx
# DUCKCLAW_LLM_MODEL=<mismo que MLX_MODEL_ID>
# DUCKCLAW_LLM_BASE_URL=http://127.0.0.1:8080/v1

# ── Observability (opcional) ─────────────────────────────────────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=duckclaw
SEND_TO_LANGSMITH=false
# DUCKCLAW_SAVE_CONVERSATION_TRACES=true
# DUCKCLAW_CONVERSATION_TRACES_DIR=

# ── DuckDB / bóvedas ─────────────────────────────────────────────────────────
# DUCKDB_PATH=db/private/<vault_user_id>/main.duckdb
# DUCKCLAW_SHARED_DB_PATH=db/shared/default/shared.duckdb
# DUCKCLAW_MULTI_VAULT_INITIAL_VAULT_ID=

# ── LLM providers ────────────────────────────────────────────────────────────
# Preferencia runtime: DUCKCLAW_LLM_* (gateway). LLM_* se copia al arrancar si falta DUCKCLAW_*.
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com/
DEEPSEEK_API_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
# DUCKCLAW_LLM_INVOKE_MAX_ATTEMPTS=3
# DUCKCLAW_GROQ_MAX_INPUT_TOKENS=5000

# ── Gateway / Redis / repo ───────────────────────────────────────────────────
DUCKCLAW_GATEWAY_PORT=8000
DUCKCLAW_GATEWAY_HOST=127.0.0.1
DUCKCLAW_GATEWAY_URL=http://127.0.0.1:8000
DUCKCLAW_MCP_PORT=8001
REDIS_URL=redis://localhost:6379/0
# DUCKCLAW_REPO_ROOT=/absolute/path/to/duckclaw
# DUCKCLAW_PM2_PYTHON=/absolute/path/to/duckclaw/.venv/bin/python3
# DUCKCLAW_TAILSCALE_AUTH_KEY=
CHAT_PARALLEL_INVOCATIONS=true
DOTENV_IMMUTABLE=1
HEARTBEAT_PLAN_TITLE_INLINE_MAX=90

# ── Telegram ─────────────────────────────────────────────────────────────────
# Bot único (polling / fallback): TELEGRAM_BOT_TOKEN=
# Por worker (manifest id → MAYÚSCULAS, guiones → _): TELEGRAM_<WORKER_ID>_TOKEN=
#   Ej.: worker `default` → TELEGRAM_DEFAULT_TOKEN=  ·  worker `bi_analyst` → TELEGRAM_BI_ANALYST_TOKEN=
# Multiplex webhook (varios bots, un gateway): DUCKCLAW_TELEGRAM_WEBHOOK_ROUTES=...
# DUCKCLAW_PUBLIC_URL=https://tu-nodo.ts.net
# DUCKCLAW_PM2_APP_WORKER_MAP=DuckClaw-Gateway:default
# TELEGRAM_WEBHOOK_SECRET=
# DUCKCLAW_TELEGRAM_INBOUND_QUEUE=0
TELEGRAM_MCP_ENABLED=1

# ── Admin consola (apps/duckclaw-admin) ──────────────────────────────────────
# DUCKCLAW_DEV_MODE=1
DUCKCLAW_ADMIN_API_KEY=change-me-local-admin-key
DUCKCLAW_ADMIN_EMAIL=admin@duckclaw.local
DUCKCLAW_ADMIN_PASSWORD=change-me-min-8-chars
SESSION_TTL_SECONDS=43200
COOKIE_DOMAIN=
ENV=development
ARGON2_TIME=2
ARGON2_MEMORY_KB=65536
ARGON2_PARALLELISM=4
PBKDF2_ITERATIONS=260000
GATEWAY_INTERNAL_URL=http://127.0.0.1:8000
SHOW_DEV_HINT=false

# ── Equipo / tenant (opcional) ─────────────────────────────────────────────────
# DUCKCLAW_TEAM_MEMBERS=platform-orchestrator,default
# DUCKCLAW_TEAM_COORDINATOR=platform-orchestrator
# DUCKCLAW_DEFAULT_WORKER_ID=default
# DUCKCLAW_GATEWAY_TENANT_ID=default

# ── Integraciones opcionales ─────────────────────────────────────────────────
TAVILY_API_KEY=
GITHUB_TOKEN=
# FAL_KEY=
# HIGGSFIELD_API_KEY=
# COMFYUI_API_URL=http://127.0.0.1:8188
# DUCKCLAW_COMFYUI_INBOUND_EDIT=1

# ── Sensory STT/TTS (Mac mini vía Tailscale, opcional) ────────────────────────
# DUCKCLAW_SENSORY_BASE_URL=http://100.x.x.x:8001
# DUCKCLAW_SENSORY_BIND_HOST=100.x.x.x
# DUCKCLAW_SENSORY_PORT=8001

# ── Pipecat Voice Realtime (opcional; proceso PM2 DuckClaw-Voice) ─────────────
# DUCKCLAW_VOICE_ENABLED=false
# DUCKCLAW_VOICE_BIND_HOST=127.0.0.1
# DUCKCLAW_VOICE_PORT=8012
# DUCKCLAW_VOICE_TRANSPORT=small_webrtc
# DUCKCLAW_VOICE_GATEWAY_URL=http://127.0.0.1:8000
# DUCKCLAW_VOICE_GATEWAY_ADMIN_KEY=
# DUCKCLAW_VOICE_DEFAULT_WORKER=default
# DUCKCLAW_VOICE_DEFAULT_TENANT=default
# DUCKCLAW_VOICE_STT_PROVIDER=deepgram
# DUCKCLAW_VOICE_TTS_PROVIDER=cartesia
# DEEPGRAM_API_KEY=
# CARTESIA_API_KEY=
# DAILY_API_KEY=
# DAILY_ROOM_URL=
# DUCKCLAW_VOICE_GRAPH_TIMEOUT_SEC=120
# DUCKCLAW_VOICE_PROGRESS_PHRASE=Un momento, estoy consultando datos.
# DUCKCLAW_VOICE_EMPTY_REPLY_PHRASE=El agente no devolvió respuesta.
# DUCKCLAW_VOICE_GATEWAY_REJECTED_PHRASE=Worker no disponible.
# Gateway health probe for admin UI live voice (not exposed to browser)
# DUCKCLAW_VOICE_INTERNAL_URL=http://127.0.0.1:8012
# Coexistencia: Sensory batch sigue en DUCKCLAW_SENSORY_BASE_URL (Telegram / playground/voice)

# ── Context monitor (compactación LLM del hilo, default ON) ─────────────────
# DUCKCLAW_CONTEXT_PRUNE_ENABLED=1
# Umbral en millones de tokens estimados (chars/4). Default 4 → 4_000_000.
# DUCKCLAW_CONTEXT_PRUNE_MAX_TOKENS_M=4
# Persistir resumen en bóveda DuckDB conectada (agent_config context_fold_summary)
# DUCKCLAW_CONTEXT_FOLD_PERSIST=1
# DUCKCLAW_CONTEXT_PRUNE_KEEP_LAST_MESSAGES=6
# DUCKCLAW_CONTEXT_PRUNE_MAX_MESSAGES=10000
# DUCKCLAW_CONTEXT_PRUNE_TOOL_MAX_CHARS=8000
# Modelo opcional solo para fold (default = LLM del worker):
# DUCKCLAW_SUMMARY_LLM_PROVIDER=openrouter
# DUCKCLAW_SUMMARY_LLM_MODEL=...
# Tras cambiar en VPS: pm2 restart DuckClaw-Gateway --update-env

# RAG
DUCKCLAW_KNOWLEDGE_ALLOWED_ROOTS=
DUCKCLAW_KNOWLEDGE_OUTPUT_ROOTS=
#DUCKCLAW_KNOWLEDGE_AUTO_SYNC=true          # default ON
#DUCKCLAW_KNOWLEDGE_AUTO_SYNC_POLL_SEC=15
#DUCKCLAW_KNOWLEDGE_EMBED_BATCH_SIZE=32      # chunks por batch de embeddings
#DUCKCLAW_KNOWLEDGE_INDEXER_MAX_INFLIGHT=1   # jobs concurrentes en indexer
#DUCKCLAW_KNOWLEDGE_QUEUE_DEPTH_WARN=10       # log si LLEN cola RAG supera umbral  