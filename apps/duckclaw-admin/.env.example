# DuckClaw Admin UI — copiar a .env.local (no commitear)
# Documentación: docs/environment.md

# Puerto fijo (Tailscale funnel / Serve apunta aquí)
PORT=3001

# Base URL del API Gateway (mismo host que pm2 DuckClaw-Gateway)
# URL completa del gateway (preferida) o puerto + host:
DUCKCLAW_GATEWAY_URL=http://127.0.0.1:8000
# DUCKCLAW_GATEWAY_PORT=8000
# DUCKCLAW_GATEWAY_HOST=127.0.0.1

# Debe coincidir con DUCKCLAW_ADMIN_API_KEY en el .env raíz del monorepo
DUCKCLAW_ADMIN_API_KEY=change-me-local-admin-key

# Seed login (hub DuckDB) — nunca commitear valores reales; password mín. 8 caracteres
DUCKCLAW_ADMIN_EMAIL=admin@duckclaw.local
DUCKCLAW_ADMIN_PASSWORD=change-me-min-8-chars

# Auth / sesiones (gateway — deben coincidir con .env raíz del monorepo)
SESSION_TTL_SECONDS=43200
COOKIE_DOMAIN=
ENV=development
ARGON2_TIME=2
ARGON2_MEMORY_KB=65536
ARGON2_PARALLELISM=4
PBKDF2_ITERATIONS=260000
GATEWAY_INTERNAL_URL=http://127.0.0.1:8000

# Dev hint en login (solo NODE_ENV=development + SHOW_DEV_HINT=true)
SHOW_DEV_HINT=false
NEXT_PUBLIC_DEV_HINT_EMAIL=admin@duckclaw.local

# Opcional: URL pública Admin (redirect OAuth Higgsfield MCP post-login)
# DUCKCLAW_ADMIN_URL=https://admin.tu-dominio.ts.net
# DUCKCLAW_MCP_OAUTH_REDIRECT_URI=

# Pipecat live voice — BFF proxy to DuckClaw-Voice (server-side only)
# DUCKCLAW_VOICE_INTERNAL_URL=http://127.0.0.1:8012
